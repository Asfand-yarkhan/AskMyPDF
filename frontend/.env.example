# Base URL of the FastAPI backend as seen by the browser.
# Default "/api" uses the Vite dev proxy (dev) or nginx (Docker).
VITE_API_URL=/api

# Firebase Authentication (Firebase console > Project settings > Your apps > Web app).
# These are public identifiers, not secrets; security comes from Firebase rules and the
# backend verifying tokens. Leave empty to run without accounts (local development).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
