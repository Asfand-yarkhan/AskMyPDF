# Copy to backend/.env and fill in ONE provider's key. Never commit .env.

# ---- LLM: groq | openai | gemini ----
LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b            # default per provider if unset
# ROUTER_MODEL=openai/gpt-oss-20b           # small/fast model for intent routing + query rewriting
GROQ_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1  # any OpenAI-compatible server, e.g. Ollama
GOOGLE_API_KEY=
REASONING_EFFORT=high                     # gpt-oss only: low | medium | high (faster vs more accurate)
QA_TEMPERATURE=0
QUIZ_TEMPERATURE=0.4

# ---- Embeddings: huggingface | openai | gemini ----
EMBEDDING_PROVIDER=huggingface
# Multilingual (English, Urdu, Roman Urdu, 90+ languages). Changing it re-indexes documents on restart.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
# HF_TOKEN=                               # optional Hugging Face token (higher download rate limits)

# ---- Retrieval: BM25 keywords + vectors, fused, then reranked ----
RETRIEVAL_K=5                           # passages given to the LLM
RETRIEVAL_FETCH_K=20                    # candidates per search method before fusion
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1   # off = no reranking (faster, ~400 MB less RAM, less precise)
RERANK_CANDIDATES=20
FULL_CONTEXT_MAX_CHARS=14000            # documents this small are read in full instead of searched

# ---- Answer cache (summaries, notes, first questions) ----
CACHE_ENABLED=true
CACHE_TTL_HOURS=168

# ---- Rate limits (Groq free tier: 8k tokens/min per model) ----
LLM_MAX_RETRIES=6                       # waits for the provider's retry-after on 429s
SUMMARY_MAX_INPUT_CHARS=24000           # raise (e.g. 150000) on a paid plan for fuller summaries

# ---- Storage / limits ----
# DATA_DIR=./data
MAX_UPLOAD_MB=50
MAX_PAGES=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://askmypdf(-[a-z0-9-]+)?\.vercel\.app   # e.g. Vercel preview deployments

# ---- Accounts (Firebase Authentication) ----
# Leave unset for local use without sign-in. Set it to your Firebase project id to require
# accounts: visitors get GUEST_TRIALS free AI requests, then must sign up.
# FIREBASE_PROJECT_ID=askmypdf-12345
GUEST_TRIALS=3
GUEST_IP_TRIALS_PER_DAY=10                # per network, so clearing browser data doesn't reset trials
GUEST_MAX_DOCUMENTS=1
USER_MAX_DOCUMENTS=50
# FILE_URL_SECRET=                        # signs PDF links; auto-generated into DATA_DIR if unset

# ---- OCR for scanned PDFs (needs the Tesseract binary installed) ----
OCR_ENABLED=true
OCR_LANGUAGE=eng
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

LOG_LEVEL=INFO
